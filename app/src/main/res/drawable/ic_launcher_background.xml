<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono adaptable: degradado sutil entre dos tonos de
  violeta oscuro. Se define como vector con <gradient> para no
  depender de imagenes PNG y escalar en cualquier densidad.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#FF312E81" />
                <item android:offset="1.0" android:color="#FF6D28D9" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
